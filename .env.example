# Application
APP_ENV=local
APP_NAME=quant-system
DATA_MODE=real
MOCK_MODE=false
PRIMARY_DATA_SOURCE=tencent
FALLBACK_DATA_SOURCE=efinance
QUANT_PRIMARY_DATA_SOURCE=tencent
QUANT_FALLBACK_DATA_SOURCE=efinance
ENABLE_PROVIDER_FALLBACK=true
AKSHARE_ENABLED=true
EFINANCE_ENABLED=true
BAOSTOCK_ENABLED=true
LIGHTWEIGHT_QUOTE_ENABLED=true
BOOTSTRAP_ENABLED=true
BOOTSTRAP_DATA_DIR=/app/data/bootstrap
MARKET_PROVIDER_TIMEOUT=8
MARKET_TOTAL_TIMEOUT=15
REALTIME_CACHE_TTL=5
STOCK_LIST_CACHE_TTL=86400
KLINE_CACHE_TTL=3600
ALLOW_STALE_CACHE=true
STALE_CACHE_MAX_SECONDS=300
DATA_SOURCE_CALL_TIMEOUT=8
# Docker 容器如处于 Clash Fake-IP/TUN 网络，可设置为宿主机代理，例如：
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,mysql,redis,etcd,rabbitmq,qdrant,quant-python,gateway-api,user-rpc,market-rpc,strategy-rpc,backtest-rpc,paper-rpc,risk-rpc,rag-rpc,agent-rpc,task-rpc,notify-rpc,ws-api
QUANT_HTTP_PROXY=

# Agent report engine. Leave Base URL empty to use the built-in local rules
# engine, or configure any OpenAI-compatible /v1 endpoint.
LLM_PROVIDER=local-rules
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=quant-tool-synthesis-v1
MODEL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
QUANT_HTTPS_PROXY=
QUANT_NO_PROXY=localhost,127.0.0.1,mysql,redis,etcd,rabbitmq,qdrant,quant-python,gateway-api,user-rpc,market-rpc,strategy-rpc,backtest-rpc,paper-rpc,risk-rpc,rag-rpc,agent-rpc,task-rpc,notify-rpc,ws-api
DOCKER_DNS_PRIMARY=223.5.5.5
DOCKER_DNS_SECONDARY=119.29.29.29
TZ=Asia/Shanghai

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=quant_system
MYSQL_USER=quant
MYSQL_PASSWORD=quant_password
MYSQL_ROOT_PASSWORD=root_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Go backend
GO_BACKEND_PORT=8080
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE_HOURS=72
PYTHON_QUANT_BASE_URL=http://quant-python:8000
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# Python quant service
PYTHON_QUANT_PORT=8000
TUSHARE_TOKEN=
AKSHARE_TIMEOUT_SECONDS=20
COLLECT_CRON_REALTIME=*/30 * * * * *
COLLECT_CRON_DAILY=0 30 17 * * 1-5

# Frontend
FRONTEND_PORT=8088
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_WS_BASE_URL=ws://127.0.0.1:8081

# Paper trading defaults
PAPER_DEFAULT_COMMISSION_RATE=0.0003
PAPER_DEFAULT_SLIPPAGE_RATE=0.0001
